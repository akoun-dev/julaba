generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Merchant {
  id            String   @id @default(cuid())
  firstName      String
  lastName       String?
  phone         String   @unique
  pinHash       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  products      Product[]
  sales         Sale[]
  expenses      Expense[]
  caisseSessions CaisseSession[]
  tontines      TontineMember[]
  voiceLogs     VoiceLog[]
}

model Product {
  id          String   @id @default(cuid())
  merchantId  String
  name        String
  category    String   @default("autre")
  priceUnit   Int      @default(0)
  stockQty    Int      @default(0)
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  merchant    Merchant @relation(fields: [merchantId], references: [id])
  saleItems   SaleItem[]
}

model Sale {
  id            String   @id @default(cuid())
  merchantId    String
  sessionId     String?
  totalAmount   Int
  changeAmount  Int      @default(0)
  amountReceived Int     @default(0)
  isVoiceSale   Boolean  @default(false)
  voiceTranscript String?
  note          String?
  createdAt     DateTime @default(now())
  
  merchant      Merchant @relation(fields: [merchantId], references: [id])
  items         SaleItem[]
  caisseSession CaisseSession? @relation(fields: [sessionId], references: [id])
}

model SaleItem {
  id          String @id @default(cuid())
  saleId      String
  productId   String?
  productName String
  quantity    Int
  unitPrice   Int
  subtotal    Int
  
  sale        Sale @relation(fields: [saleId], references: [id])
  product     Product? @relation(fields: [productId], references: [id])
}

model Expense {
  id          String   @id @default(cuid())
  merchantId  String
  amount      Int
  category    String
  description String?
  isVoice     Boolean  @default(false)
  voiceTranscript String?
  createdAt   DateTime @default(now())
  
  merchant    Merchant @relation(fields: [merchantId], references: [id])
}

model CaisseSession {
  id            String   @id @default(cuid())
  merchantId    String
  fondDeCaisse  Int
  totalVentes   Int      @default(0)
  totalDepenses Int      @default(0)
  totalFinal    Int      @default(0)
  isOpen        Boolean  @default(true)
  openedAt      DateTime @default(now())
  closedAt      DateTime?
  
  merchant      Merchant @relation(fields: [merchantId], references: [id])
  sales         Sale[]
}

model Tontine {
  id            String   @id @default(cuid())
  name          String
  amount        Int
  frequency     String   @default("mensuel")
  memberCount   Int      @default(0)
  nextDueDate   DateTime?
  createdAt     DateTime @default(now())
  
  members       TontineMember[]
}

model TontineMember {
  id          String   @id @default(cuid())
  tontineId   String
  merchantId  String
  joinedAt    DateTime @default(now())
  
  tontine     Tontine @relation(fields: [tontineId], references: [id])
  merchant    Merchant @relation(fields: [merchantId], references: [id])
}

model VoiceLog {
  id            String   @id @default(cuid())
  merchantId    String
  transcript     String
  intent         String?
  confidence     Float?
  responseText   String?
  createdAt     DateTime @default(now())
  
  merchant      Merchant @relation(fields: [merchantId], references: [id])
}

// ============== BACKOFFICE MODELS ==============

model BoUser {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  role          String   @default("operateur_terrain") // super_admin, admin_general, admin_national, gestionnaire_zone, operateur_terrain
  zone          String?
  isActive      Boolean  @default(true)
  lastLogin     DateTime?
  mfaSecret     String?
  forcePasswordChange Boolean @default(false)
  failedLoginAttempts Int  @default(0)
  lockedUntil   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  auditLogs     AuditLog[]
  sessions      BoSession[]
  mfaChallenges BoMfaChallenge[]
}

// Server-verifiable Backoffice session, referenced by an opaque token whose
// hash is stored here. The raw token only ever lives in the HTTP-only cookie.
model BoSession {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  lastUsedAt  DateTime  @default(now())
  revokedAt   DateTime?

  user        BoUser    @relation(fields: [userId], references: [id])

  @@index([userId])
}

// Short-lived server-side MFA (OTP) challenge issued after password
// verification. The session cookie is only granted once this is consumed.
model BoMfaChallenge {
  id          String    @id @default(cuid())
  userId      String
  codeHash    String
  attempts    Int       @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  user        BoUser    @relation(fields: [userId], references: [id])

  @@index([userId])
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String
  userName      String
  userEmail     String
  action        String
  module        String
  details       String?  // JSON string
  ipAddress     String?
  userAgent     String?
  signature     String?  // SHA-256
  createdAt     DateTime @default(now())
  
  user          BoUser   @relation(fields: [userId], references: [id])
}

model BoActor {
  id            String   @id @default(cuid())
  actorId       String   @unique // e.g. #M-0845
  firstName     String
  lastName      String?
  type          String   @default("marchand") // marchand, producteur, cooperatif
  phone         String
  zone          String
  status        String   @default("actif") // actif, suspendu, en_attente, rejete
  photoUrl      String?
  gpsLat        Float?
  gpsLng        Float?
  identificateurName String?
  identificateurId   String?
  validatedBy   String?
  validatedAt   DateTime?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BoZone {
  id            String   @id @default(cuid())
  name          String   @unique
  region        String
  identificateurCount Int @default(0)
  actorCount    Int      @default(0)
  target        Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BoMission {
  id            String   @id @default(cuid())
  title         String
  description   String?
  zone          String
  assigneeId    String?
  assigneeName  String?
  status        String   @default("en_cours") // en_cours, terminee, suspendue
  targetCount   Int      @default(0)
  currentCount  Int      @default(0)
  startDate     DateTime
  endDate       DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BoEnrolment {
  id                String   @id @default(cuid())
  dossierId         String   @unique
  actorName         String
  actorType         String   @default("marchand")
  zone              String
  identificateurName String
  status            String   @default("en_attente")
  hasPhoto          Boolean  @default(false)
  hasGps            Boolean  @default(false)
  phone             String
  submittedAt       DateTime @default(now())
  validatedBy       String?
  validatedAt       DateTime?
  rejectReason      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model BoAlert {
  id            String   @id @default(cuid())
  severity      String   @default("moyenne")
  title         String
  message       String
  module        String
  acknowledged  Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model BoInstitution {
  id            String   @id @default(cuid())
  name          String
  type          String
  contactName   String?
  contactEmail  String?
  contactPhone  String?
  address       String?
  linkedActors  Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BoMutation {
  id            String   @id @default(cuid())
  actorId       String
  actorName     String
  fromZone      String
  toZone        String
  reason        String?
  status        String   @default("en_attente")
  requestedBy   String?
  requestedAt   DateTime @default(now())
  processedBy   String?
  processedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BoModerationReport {
  id            String   @id @default(cuid())
  targetType    String
  targetId      String?
  targetName    String?
  reason        String
  severity      String   @default("moyenne")
  status        String   @default("en_attente")
  reportedBy    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BoContent {
  id            String   @id @default(cuid())
  title         String
  type          String
  category      String?
  content       String
  author        String?
  status        String   @default("publie")
  viewCount     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BoCommunication {
  id            String   @id @default(cuid())
  title         String
  type          String
  content       String
  targetGroup   String
  targetZone    String?
  status        String   @default("envoyee")
  sentCount     Int      @default(0)
  deliveryRate  Float?
  sentAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BoApiKey {
  id            String   @id @default(cuid())
  name          String
  key           String   @unique
  secret        String
  permissions   String   @default("read")
  requestCount  Int      @default(0)
  lastUsedAt    DateTime?
  expiresAt     DateTime?
  isActive      Boolean  @default(true)
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BoDelivery {
  id            String   @id @default(cuid())
  orderId       String?
  senderName    String
  senderPhone   String
  recipientName String
  recipientPhone String
  address       String
  zone          String
  status        String   @default("en_attente")
  courierName   String?
  pickupAt      DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BoCronJob {
  id            String   @id @default(cuid())
  name          String
  schedule      String
  command       String?
  status        String   @default("actif")
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  durationMs    Int?
  runCount      Int      @default(0)
  avgDurationMs Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BoCreditScore {
  id            String   @id @default(cuid())
  actorId       String
  actorName     String
  zone          String
  score         Int
  riskLevel     String
  creditLimit   Int?
  lastCalculatedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BoKeiwaTransaction {
  id            String   @id @default(cuid())
  type          String
  amount        Int
  senderName    String?
  senderPhone   String?
  recipientName String?
  recipientPhone String?
  accountId     String?
  account       BoKeiwaAccount? @relation(fields: [accountId], references: [id])
  status        String   @default("termine")
  createdAt     DateTime @default(now())
}

model BoKeiwaAccount {
  id            String   @id @default(cuid())
  holderName    String
  holderPhone   String
  zone          String?
  balance       Int      @default(0)
  transactionCount Int @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  transactions   BoKeiwaTransaction[]
}

model BoPlatformConfig {
  id            String   @id @default(cuid())
  category      String   @unique
  config        String
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

model BoSystemEvent {
  id            String   @id @default(cuid())
  level         String   @default("INFO") // INFO, WARN, ERROR, DEBUG
  source        String
  message       String
  createdAt     DateTime @default(now())

  @@index([level])
  @@index([createdAt])
}
