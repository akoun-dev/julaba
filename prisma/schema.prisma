generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Merchant {
  id             String   @id @default(cuid())
  firstName      String
  lastName       String?
  phone          String   @unique
  // Exactly one of these three is set, matching the auth method chosen at
  // registration (PIN, pattern lock, or visual code grid) — the mobile app
  // supports all three, so the server can't require pinHash alone anymore.
  authMethod     String   @default("pin") // "pin" | "pattern" | "visual"
  pinHash        String?
  patternHash    String?
  visualCodeHash String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products       Product[]
  sales          Sale[]
  expenses       Expense[]
  caisseSessions CaisseSession[]
  tontines       TontineMember[]
  voiceLogs      VoiceLog[]
}

// Server-side account for the producteur app — mirrors Merchant. Only PIN and
// pattern are offered for producteur (never visual code), so there's no
// visualCodeHash field here.
model Producteur {
  id          String   @id @default(cuid())
  firstName   String
  phone       String   @unique
  authMethod  String   @default("pin") // "pin" | "pattern"
  pinHash     String?
  patternHash String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id         String   @id @default(cuid())
  merchantId String
  // Client-generated id sent by the offline queue (see offline-db.ts) so a
  // retried sync after a lost response doesn't create a duplicate product —
  // previously this was faked by matching on merchantId+name, which treated
  // two genuinely distinct restocks of the same product name as one duplicate.
  clientId   String?  @unique
  name       String
  category   String   @default("autre")
  priceUnit  Int      @default(0)
  stockQty   Int      @default(0)
  imageUrl   String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  merchant  Merchant   @relation(fields: [merchantId], references: [id])
  saleItems SaleItem[]
}

model Sale {
  id              String   @id @default(cuid())
  merchantId      String
  sessionId       String?
  // Client-generated id for idempotent retries (see Product.clientId) —
  // previously this was smuggled as a "cid:<id>" prefix inside `note`,
  // which corrupted the merchant's own note text.
  clientId        String?  @unique
  totalAmount     Int
  changeAmount    Int      @default(0)
  amountReceived  Int      @default(0)
  isVoiceSale     Boolean  @default(false)
  voiceTranscript String?
  note            String?
  createdAt       DateTime @default(now())

  merchant      Merchant       @relation(fields: [merchantId], references: [id])
  items         SaleItem[]
  caisseSession CaisseSession? @relation(fields: [sessionId], references: [id])
}

model SaleItem {
  id          String  @id @default(cuid())
  saleId      String
  productId   String?
  productName String
  quantity    Int
  unitPrice   Int
  subtotal    Int

  sale    Sale     @relation(fields: [saleId], references: [id])
  product Product? @relation(fields: [productId], references: [id])
}

model Expense {
  id              String   @id @default(cuid())
  merchantId      String
  // Client-generated id for idempotent retries (see Product.clientId) —
  // previously this was smuggled as a "cid:<id>" prefix inside `description`.
  clientId        String?  @unique
  amount          Int
  category        String
  description     String?
  isVoice         Boolean  @default(false)
  voiceTranscript String?
  createdAt       DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id])
}

model CaisseSession {
  id            String    @id @default(cuid())
  merchantId    String
  fondDeCaisse  Int
  totalVentes   Int       @default(0)
  totalDepenses Int       @default(0)
  totalFinal    Int       @default(0)
  isOpen        Boolean   @default(true)
  openedAt      DateTime  @default(now())
  closedAt      DateTime?

  merchant Merchant @relation(fields: [merchantId], references: [id])
  sales    Sale[]
}

model Tontine {
  id          String    @id @default(cuid())
  name        String
  amount      Int
  frequency   String    @default("mensuel")
  memberCount Int       @default(0)
  nextDueDate DateTime?
  createdAt   DateTime  @default(now())

  members TontineMember[]
}

model TontineMember {
  id         String   @id @default(cuid())
  tontineId  String
  merchantId String
  joinedAt   DateTime @default(now())

  tontine  Tontine  @relation(fields: [tontineId], references: [id])
  merchant Merchant @relation(fields: [merchantId], references: [id])
}

model TontineContribution {
  id         String   @id @default(cuid())
  tontineId  String
  merchantId String
  amount     Int
  clientId   String?  @unique
  createdAt  DateTime @default(now())

  @@index([tontineId])
  @@index([merchantId])
}

model VoiceLog {
  id           String   @id @default(cuid())
  merchantId   String
  transcript   String
  intent       String?
  confidence   Float?
  responseText String?
  createdAt    DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id])
}

// ============== BACKOFFICE MODELS ==============

model BoUser {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  name                String
  role                String    @default("operateur_terrain") // super_admin, admin_general, admin_national, gestionnaire_zone, operateur_terrain
  zone                String?
  isActive            Boolean   @default(true)
  lastLogin           DateTime?
  mfaSecret           String?
  forcePasswordChange Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  auditLogs        AuditLog[]
  sessions         BoSession[]
  mfaChallenges    BoMfaChallenge[]
  // Field agents identified through identificateurId are looked up here too —
  // kept optional/SetNull so removing a BoUser account never blocks or wipes
  // the actors they enrolled.
  actorsIdentified BoActor[]        @relation("ActorIdentificateur")
  missionsAssigned BoMission[]

  @@index([zone])
  @@index([role])
}

// Server-verifiable Backoffice session, referenced by an opaque token whose
// hash is stored here. The raw token only ever lives in the HTTP-only cookie.
model BoSession {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?

  user BoUser @relation(fields: [userId], references: [id])

  @@index([userId])
}

// Short-lived server-side MFA (OTP) challenge issued after password
// verification. The session cookie is only granted once this is consumed.
model BoMfaChallenge {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user BoUser @relation(fields: [userId], references: [id])

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  userName  String
  userEmail String
  action    String
  module    String
  details   String? // JSON string
  ipAddress String?
  userAgent String?
  signature String? // SHA-256
  createdAt DateTime @default(now())

  user BoUser @relation(fields: [userId], references: [id])

  @@index([module])
  @@index([action])
  @@index([createdAt])
}

model BoActor {
  id                 String    @id @default(cuid())
  actorId            String    @unique // e.g. #M-0845
  firstName          String
  lastName           String?
  type               String    @default("marchand") // marchand, producteur, cooperatif
  phone              String
  zone               String
  status             String    @default("actif") // actif, suspendu, en_attente, rejete
  photoUrl           String?
  gpsLat             Float?
  gpsLng             Float?
  identificateurName String?
  identificateurId   String?
  validatedBy        String?
  validatedAt        DateTime?
  notes              String?
  // Set when this actor row was auto-created/linked from a self-service
  // marchand or producteur account (device-claim registration, no
  // identificateur involved) — see /api/session/link-actor. Lets the
  // backoffice's Acteurs/Producteurs screens show a real identity instead
  // of an opaque raw id for accounts that never went through enrolment.
  merchantId         String?   @unique
  producteurId       String?   @unique
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // identificateurId is a real FK once an actor's dossier names a known
  // BoUser; identificateurName stays as the display cache (kept in sync by
  // whoever writes it) so a deleted account never blanks a completed record.
  identificateur BoUser?         @relation("ActorIdentificateur", fields: [identificateurId], references: [id], onDelete: SetNull)
  mutations      BoMutation[]
  creditScores   BoCreditScore[]

  @@index([zone])
  @@index([status])
  @@index([type])
  @@index([identificateurId])
}

model BoZone {
  id                  String   @id @default(cuid())
  name                String   @unique
  region              String
  identificateurCount Int      @default(0)
  actorCount          Int      @default(0)
  target              Int      @default(0)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([region])
}

model BoMission {
  id           String    @id @default(cuid())
  title        String
  description  String?
  zone         String
  assigneeId   String?
  assigneeName String?
  status       String    @default("en_cours") // en_cours, terminee, suspendue
  targetCount  Int       @default(0)
  currentCount Int       @default(0)
  startDate    DateTime
  endDate      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignee BoUser? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([zone])
  @@index([status])
  @@index([assigneeId])
}

model BoEnrolment {
  id                 String    @id @default(cuid())
  dossierId          String    @unique
  actorName          String
  actorType          String    @default("marchand")
  zone               String
  identificateurId   String?
  identificateurName String
  status             String    @default("en_attente")
  hasPhoto           Boolean   @default(false)
  hasGps             Boolean   @default(false)
  phone              String
  submittedAt        DateTime  @default(now())
  validatedBy        String?
  validatedAt        DateTime?
  rejectReason       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([zone])
  @@index([status])
  @@index([identificateurId])
}

model BoAlert {
  id           String   @id @default(cuid())
  severity     String   @default("moyenne")
  title        String
  message      String
  module       String
  acknowledged Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([module])
  @@index([acknowledged])
}

model BoInstitution {
  id           String   @id @default(cuid())
  name         String
  type         String
  contactName  String?
  contactEmail String?
  contactPhone String?
  address      String?
  linkedActors Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([type])
}

model BoMutation {
  id          String    @id @default(cuid())
  actorId     String
  actorName   String
  fromZone    String
  toZone      String
  reason      String?
  status      String    @default("en_attente")
  requestedBy String?
  requestedAt DateTime  @default(now())
  processedBy String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // actorId here is BoActor's display code (e.g. #M-0845), matching how this
  // route already receives and stores it — relates on that unique field
  // instead of the cuid so no existing data or caller needs to change.
  actor BoActor @relation(fields: [actorId], references: [actorId])

  @@index([actorId])
  @@index([status])
}

model BoModerationReport {
  id         String   @id @default(cuid())
  targetType String
  targetId   String?
  targetName String?
  reason     String
  severity   String   @default("moyenne")
  status     String   @default("en_attente")
  reportedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // targetId is deliberately not a hard relation: targetType varies
  // (actor/contenu/communication/...) and, unlike BoMutation, the seeded
  // values mix BoActor's cuid with plain string ids for non-actor targets —
  // a real polymorphic reference would need a discriminated per-type FK,
  // which is a bigger modeling change than this pass covers.
  @@index([status])
  @@index([targetType, targetId])
}

model BoContent {
  id        String   @id @default(cuid())
  title     String
  type      String
  category  String?
  content   String
  author    String?
  status    String   @default("publie")
  viewCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([type])
}

model BoCommunication {
  id           String    @id @default(cuid())
  title        String
  type         String
  content      String
  targetGroup  String
  targetZone   String?
  status       String    @default("envoyee")
  sentCount    Int       @default(0)
  deliveryRate Float?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
}

model BoApiKey {
  id           String    @id @default(cuid())
  name         String
  description  String?
  key          String    @unique
  // SHA-256 of the actual secret, generated with crypto.randomBytes — the
  // secret itself is only ever returned once, in the create response (see
  // /api/backoffice/api-keys POST); it is never stored or re-displayed in
  // clear afterward.
  secretHash   String
  permissions  String    @default("read")
  requestCount Int       @default(0)
  lastUsedAt   DateTime?
  expiresAt    DateTime?
  isActive     Boolean   @default(true)
  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isActive])
}

model BoDelivery {
  id             String    @id @default(cuid())
  orderId        String?
  senderName     String
  senderPhone    String
  recipientName  String
  recipientPhone String
  address        String
  zone           String
  status         String    @default("en_attente")
  courierName    String?
  pickupAt       DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // orderId is not a relation: no Order/Commande model exists yet for
  // marketplace orders, so there is nothing on the other end to point to.
  @@index([zone])
  @@index([status])
}

model BoCronJob {
  id            String    @id @default(cuid())
  name          String
  schedule      String
  command       String?
  status        String    @default("actif")
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  durationMs    Int?
  runCount      Int       @default(0)
  avgDurationMs Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
}

model BoCreditScore {
  id               String    @id @default(cuid())
  actorId          String
  actorName        String
  zone             String
  score            Int
  riskLevel        String
  creditLimit      Int?
  lastCalculatedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  actor BoActor @relation(fields: [actorId], references: [actorId])

  @@index([actorId])
  @@index([zone])
  @@index([riskLevel])
}

model BoKeiwaTransaction {
  id             String          @id @default(cuid())
  type           String
  amount         Int
  senderName     String?
  senderPhone    String?
  recipientName  String?
  recipientPhone String?
  accountId      String?
  account        BoKeiwaAccount? @relation(fields: [accountId], references: [id])
  status         String          @default("termine")
  createdAt      DateTime        @default(now())
}

model BoKeiwaAccount {
  id               String               @id @default(cuid())
  holderName       String
  holderPhone      String
  zone             String?
  balance          Int                  @default(0)
  transactionCount Int                  @default(0)
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  transactions     BoKeiwaTransaction[]

  @@index([zone])
}

model BoPlatformConfig {
  id        String   @id @default(cuid())
  category  String   @unique
  config    String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model BoSystemEvent {
  id        String   @id @default(cuid())
  level     String   @default("INFO") // INFO, WARN, ERROR, DEBUG
  source    String
  message   String
  createdAt DateTime @default(now())

  @@index([level])
  @@index([createdAt])
}

// Device-binding for roles that have no server-verified login (marchand,
// producteur, identificateur all authenticate locally — PIN compared against
// a hash stored on-device, never sent to the server). Without this, any API
// call carrying a valid merchantId/producteurId/identificateurId — ids that
// leak trivially, e.g. in every GET's query string — could read or write
// that subject's data from anywhere. First-claim-wins: the first device to
// present a given subject ("merchant:<id>" etc.) to POST /api/session/claim
// owns it; see src/lib/device-session.ts.
model DeviceSession {
  id        String   @id @default(cuid())
  subject   String   @unique
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

// Server-side mirror of a device's local sync_conflicts table (offline-db.ts)
// — a mutation the server definitively rejected (SyncConflictError) and that
// will never succeed on retry. Previously these only ever existed on the
// originating device, invisible to any admin; recordSyncConflict() now
// best-effort reports each one here too so the backoffice can see them.
model SyncConflictReport {
  id              String   @id @default(cuid())
  subject         String // "merchant:<id>" etc, same shape as DeviceSession.subject
  entity          String
  payload         String // JSON
  message         String
  clientCreatedAt DateTime
  reportedAt      DateTime @default(now())

  @@index([subject])
  @@index([reportedAt])
}

// In-app notification center for marchand/producteur/identificateur — the
// same "subject" shape as DeviceSession ("merchant:<id>" etc), never a
// backoffice-facing thing (that's BoAlert). Created server-side via
// createNotification() (src/lib/notifications.ts) at real domain events:
// first device claim, a sync conflict, a dossier validated/rejected, a
// tontine contribution confirmed. Read purely through the device-session
// cookie (see /api/notifications) — a subject only ever reads its own.
model Notification {
  id        String   @id @default(cuid())
  subject   String
  type      String // 'bienvenue' | 'sync_conflict' | 'dossier_valide' | 'dossier_rejete' | 'tontine_cotisation'
  title     String
  body      String
  data      String? // JSON, optional deep-link info (e.g. { dossierId })
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([subject, read])
  @@index([subject, createdAt])
}

model ProducteurRecolte {
  id                String   @id @default(cuid())
  producteurId      String
  produit           String
  quantiteKg        Float
  qualite           String // premium | standard | secondaire
  dateRecolte       DateTime
  parcelle          String
  prixSouhaiteParKg Float
  photos            String // JSON array of URLs
  statut            String   @default("brouillon") // brouillon | publiee | vendue
  acheteur          String?
  montantVente      Float?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([producteurId])
  @@index([statut])
}

model ProducteurCommande {
  id                     String   @id @default(cuid())
  producteurId           String
  reference              String   @unique
  acheteurNom            String
  produit                String
  quantiteKg             Float
  montant                Float
  dateLivraisonSouhaitee DateTime
  statut                 String   @default("a_traiter") // a_traiter | en_cours | livree | refusee
  urgent                 Boolean  @default(false)
  transporteur           String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([producteurId])
  @@index([statut])
}

model ProducteurJournal {
  id           String   @id @default(cuid())
  producteurId String
  cycleId      String
  date         DateTime
  texte        String
  photoUrl     String?
  createdAt    DateTime @default(now())

  @@index([cycleId])
  @@index([producteurId])
}
