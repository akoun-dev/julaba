    "lexicon": {
      "file": "lexicon.json",
      "relativePath": "lexicon/lexicon.json",
      "sizeBytes": 0,
      "sha256": "REPLACE_WITH_LEXICON_SHA256",
      "schemaVersion": "nouchi-lexicon-v1"
    },
    "pronunciationRules": {
      "file": "pronunciation-rules.json",
      "relativePath": "lexicon/pronunciation-rules.json",
      "sha256": "REPLACE_WITH_RULES_SHA256"
    }
  },
  "downloadPolicy": {
    "delivery": "explicit-opt-in",
    "recommendedNetwork": "wifi",
    "allowMeteredNetwork": false,
    "allowCellularOverride": true,
    "requiresFreeSpaceBytes": 120000000,
    "resumeSupported": true,
    "cancelSupported": true,
    "deleteSupported": true,
