  "normalization": {
    "amounts": {
      "currency": "XOF",
      "spokenCurrency": "francs CFA",
      "integerOnly": true,
      "decimalSeparator": null,
      "spellOutNumbers": true,
      "maxDigits": 9,
      "rejectAmbiguousAmount": true
    },
    "quantities": {
      "spellOutNumbers": true,
      "preserveUnit": true,
      "unknownUnitBehavior": "ask-for-clarification"
    },
    "abbreviations": {
      "FCFA": "francs CFA",
      "CFA": "francs CFA",
      "kg": "kilogrammes",
      "g": "grammes",
      "L": "litres"
    },
    "punctuation": {
