        "android-arm64-v8a",
        "android-armeabi-v7a",
        "ios-arm64",
        "web-wasm"
      ],
      "engineEntry": "tata-tts-ivory.ts",
      "engineMemoryMode": "single-active-instance",
      "releaseAfterInactivityMs": 30000
    },
    "model": {
      "file": "model.onnx",
      "relativePath": "models/ivoirian-tts-nouchi-v1/model.onnx",
      "sizeBytes": 48234496,
      "sizeMb": 46,
      "sha256": "REPLACE_WITH_RELEASE_SHA256",
      "quantization": "int8",
      "sampleRateHz": 22050,
      "channels": 1,
      "voiceId": "tata-nanti-lou-01",
      "speakerCount": 1,
      "requiresNetworkAtRuntime": false
