    "activationRequiresChecksum": true,
    "activationRequiresLicenseAcceptance": true,
    "showEstimatedSizeBeforeDownload": true,
    "userMessage": "Cette voix nécessite environ 46 Mo. Téléchargez-la de préférence en Wi-Fi.",
    "failureMessage": "La voix n'a pas pu être installée. Votre voix actuelle reste disponible.",
    "offlineAfterInstall": true
  },
  "deviceRequirements": {
    "minimumAndroidSdk": 26,
    "minimumRamMb": 512,
    "recommendedRamMb": 1024,
    "minimumFreeStorageMb": 120,
    "maxSynthesisTextCharacters": 500,
    "maxSegmentCharacters": 140,
    "supportsLowMemoryMode": true,
    "lowMemoryMode": {
