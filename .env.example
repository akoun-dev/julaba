# Supabase public configuration. Safe to expose only with RLS enabled.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
BACKOFFICE_MFA_TEST_MODE=false
BACKOFFICE_MFA_TEST_CODE=000000

# Exact versioned Gemma LiteRT-LM artifact and its SHA-256 checksum.
# The model is downloaded by the native Capacitor plugin, never served by Next.js.
NEXT_PUBLIC_GEMMA_MODEL_URL=https://example.invalid/models/Gemma3-1B-IT_multi-prefill-seq_q4_ekv4096.litertlm
NEXT_PUBLIC_GEMMA_MODEL_SHA256=replace-with-sha256

# Server-only values. Never prefix these with NEXT_PUBLIC_ and never ship them
# to a browser or Capacitor bundle.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key
SUPABASE_DB_URL=replace-with-postgres-connection-string
SUPABASE_ACCESS_TOKEN=replace-with-ci-token
