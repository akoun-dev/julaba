<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme.NoActionBar">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Optional hardware — app must still install on devices without a camera/GPS -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- @capacitor/camera: photo capture for actor/document enrollment -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- @capacitor/geolocation: GPS coordinates captured during enrollment -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Voice input (Web Speech API inside the WebView) for the vocal assistant -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- @capacitor/push-notifications, @capacitor/local-notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- @capacitor/local-notifications (Task 29): re-planifie les rappels
         locaux (clôture de caisse 19h, échéances de tontine) après un
         redémarrage de l'appareil. Les rappels sont volontairement INEXACTS
         (isExactNotification: false) : pas de SCHEDULE_EXACT_ALARM, donc
         aucune fenêtre système « Alarmes et rappels » pour l'utilisateur. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- @capacitor/haptics: tactile confirmation on voice sales / swipe actions -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- @capacitor/filesystem: local storage of voice recordings / compressed
         photos while offline, before sync. Only needed on Android 12 and
         below — scoped storage on 13+ makes these unnecessary for the app's
         own files. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!-- @aparajita/capacitor-biometric-auth: fingerprint/face unlock -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
</manifest>
